name: Actualizar avisos AEMET

on:
  schedule:
    - cron: "17 */2 * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  actualizar:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Leer avisos de AEMET
        run: python scripts/actualizar.py avisos.json
      - name: Guardar cambios
        run: |
          git config user.name "avisos-bot"
          git config user.email "avisos-bot@users.noreply.github.com"
          git add avisos.json
          git diff --cached --quiet || git commit -m "Avisos AEMET $(date -u +%Y-%m-%dT%H:%MZ)"
          git push
